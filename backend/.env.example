# ==============================================================================
# Supabase PostgreSQL Database Connection
# ==============================================================================
# In Supabase Dashboard -> Project Settings -> Database:
# Connection string (Direct port 5432 or Transaction Pooler port 6543):
# Format: jdbc:postgresql://db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require

SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Alternative Supabase environment variable names:
# SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# ==============================================================================
# Supabase API Credentials (Project Settings -> API)
# ==============================================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ==============================================================================
# Connection Pool & Migrations
# ==============================================================================
DB_POOL_MAX=10
DB_POOL_MIN=2
# Set to false because tables are pre-created directly in Supabase
SPRING_FLYWAY_ENABLED=false

# ==============================================================================
# JWT Security
# ==============================================================================
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
