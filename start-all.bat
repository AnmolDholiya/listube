@echo off
echo Starting Mock Flipkart Service (Port 8081)...
start "Mock Flipkart Service" cmd /k "cd mock-flipkart-service && mvn spring-boot:run"

echo Starting Mock Amazon Service (Port 8082)...
start "Mock Amazon Service" cmd /k "cd mock-amazon-service && mvn spring-boot:run"

echo Starting React Vite Frontend (Port 5174)...
start "React Frontend" cmd /k "cd frontend && npm run dev"

echo Waiting 6 seconds for background services to initialize...
timeout /t 6 /nobreak >nul

echo Starting Main Listing Platform (Port 8080)...
cd backend && mvn spring-boot:run
